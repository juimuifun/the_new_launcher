{
  "name": "the_new_launcher",
  "version": "1.0.0",
  "description": "Clean Electron Minecraft Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "npx tailwindcss -i ./src/styles/tailwind.css -o ./dist/output.css",
    "dev": "npx concurrently \"npx tailwindcss -i ./src/styles/tailwind.css -o ./dist/output.css --watch\" \"electron .\"",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron"
  ],
  "author": {
    "name": "juimuifun",
    "email": "developer@example.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.launcher.thenewlauncher",
    "productName": "The New Launcher",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "juimuifun",
      "repo": "the_new_launcher",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "maintainer": "developer@example.com",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
